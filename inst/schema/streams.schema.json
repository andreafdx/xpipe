{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["_meta"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["type", "version"],
      "properties": {
        "type": { "const": "streams_contract" },
        "version": { "type": "string" },
        "created_at": { "type": "string", "format": "date" },
        "last_updated": { "type": "string", "format": "date" },
        "maintainer": { "type": "string" },
        "change_policy": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": {
    "$ref": "#/definitions/stream"
  },
  "definitions": {
    "stream": {
      "type": "object",
      "required": ["label", "partition_granularity", "anchor", "valid_from"],
      "properties": {
        "label": { "type": "string" },
        "description": { "type": "string" },
        "partition_granularity": {
          "type": "string",
          "enum": ["year", "month"]
        },
        "anchor": {
          "type": "string",
          "enum": ["start", "end"]
        },
        "valid_from": {
          "type": "string",
          "format": "date"
        },
        "valid_to": {
          "type": ["string", "null"],
          "format": "date"
        }
      },
      "additionalProperties": false
    }
  }
}
