{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["paths"],
  "properties": {
    "paths": {
      "type": "object",
      "required": [
        "shared",
        "batch",
        "bronze"
      ],
      "properties": {
        "shared": {
          "type": "string",
          "minLength": 1
        },
        "inbox": {
          "type": "string",
          "minLength": 1
        },
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "batch": {
          "type": "string",
          "minLength": 1
        },
        "bronze": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error",
            "fatal"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
