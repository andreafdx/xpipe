{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["datastream", "expected_hash"],

  "properties": {
    "meta": {
      "type": "object"
    },

    "expected_hash": {
      "type": "string",
      "minLength": 1
    },

    "datastream": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["time_block"],
        "properties": {
          "name": {
            "type": "string"
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "time_block": {
            "type": "string",
            "enum": ["y", "q"]
          }
        },
        "additionalProperties": false
      }
    }
  },

  "additionalProperties": false
}
