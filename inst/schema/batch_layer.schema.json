{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Batch Layer Metadata Schema",
  "type": "object",
  "required": ["layer", "expected_hash"],

  "properties": {
    "layer": {
      "type": "string",
      "const": "batch"
    },

    "role": {
      "type": "string",
      "const": "immutable_event_log"
    },

    "expected_hash": {
      "type": "string",
      "minLength": 1
    },

    "storage": {
      "type": "object"
    },

    "created_at": {
      "type": "string",
      "format": "date"
    },

    "description": {
      "type": "string",
      "minLength": 1
    }
  },

  "additionalProperties": false
}
