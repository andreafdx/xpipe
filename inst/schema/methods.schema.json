{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": [
      "schema_domain",
      "type",
      "input_type",
      "primary_table",
      "identity_keys",
      "partition_column"
    ],
    "properties": {
      "schema_domain": {"type": "string","minLength": 1},
      "type": { "type": "string", "enum": ["access_mdb", "xml", "csv"] },
      "input_type": { "type": "string", "enum": ["file", "directory"] },
      "components": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          {
            "type": "array",
            "items": { "type": "string" }
          }
        ]
      },
      "table": { "type": "string" },
      "mapping": { "type": "object", "additionalProperties": { "type": "string" } },
      "primary_table": { "type": "string" },
      "identity_keys": { "type": "array", "items": { "type": "string" } },
      "partition_column": { "type": "string" },
      "pseudonymize": { "type": "array", "items": { "type": "string" } },
      "skip": { "type": "array", "items": { "type": "string" } }
    }
  }
}
