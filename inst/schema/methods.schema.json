{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",

  "additionalProperties": {
    "type": "object",
    "required": [
      "schema_domain",
      "type",
      "input_type",
      "identity_keys",
      "partition_column"
    ],

    "properties": {
      "schema_domain": {
        "type": "string",
        "minLength": 1
      },

      "type": {
        "type": "string",
        "enum": ["access_mdb", "xml", "csv"]
      },

      "input_type": {
        "type": "string",
        "enum": ["file", "directory"]
      },

      "input_map": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      },

      "components": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      },

      "anchor_table": {
        "type": "string",
        "minLength": 1
      },

      "identity_keys": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },

      "partition_column": {
        "type": "string",
        "minLength": 1
      },

      "pseudonymize": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },

      "skip": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "additionalProperties": false
  }
}
