{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["datastream", "expected_hash"],

  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true
    },

    "expected_hash": {
      "type": "string",
      "minLength": 1
    },

    "datastream": {
      "type": "object",
      "minProperties": 1,

      "additionalProperties": {
        "type": "object",
        "required": ["anchor"],

        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },

          "alt": {
            "type": "string",
            "minLength": 1
          },

          "anchor": {
            "type": "string",
            "enum": ["start", "end"]
          },

          "batch_span": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["m", "q", "y", "custom"]
            },
            "uniqueItems": true
          }
        },

        "additionalProperties": false
      }
    }
  },

  "additionalProperties": false
}
