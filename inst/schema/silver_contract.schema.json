{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Silver configuration contract",
  "type": "object",
  "required": ["_meta", "streams"],
  "additionalProperties": false,

  "properties": {
    "_meta": {
      "type": "object",
      "required": ["type", "version"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "silver_contract"
        },
        "version": {
          "type": "string"
        }
      }
    },

    "streams": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["canonical_method", "current"],
        "additionalProperties": false,

        "properties": {
          "canonical_method": {
            "type": "string",
            "description": "Method ID to be used as the canonical source for Silver-current tables."
          },

          "current": {
            "type": "object",
            "required": ["enabled"],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          },

          "harmonized": {
            "type": "object",
            "required": ["enabled"],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
