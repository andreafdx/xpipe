{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Silver configuration contract",
  "type": "object",
  "required": ["_meta", "streams"],
  "additionalProperties": false,

  "properties": {
    "_meta": {
      "type": "object",
      "required": ["type", "version"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "silver_contract"
        },
        "version": {
          "type": "string"
        }
      }
    },

    "streams": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["canonical_method", "current"],
        "additionalProperties": false,

        "properties": {
          "canonical_method": {
            "type": "string",
            "description": "Method ID to be used as the canonical source for Silver-current tables."
          },

          "current": {
            "type": "object",
            "required": ["enabled"],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              }
            }
          },

          "harmonized": {
            "type": "object",
            "required": ["enabled"],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "profile": {
                "type": "string",
                "description": "Code-driven harmonization profile identifier"
              },
              "tables": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "required": ["source", "columns"],
                  "additionalProperties": false,
                  "properties": {
                    "source": {
                      "type": "string",
                      "description": "Name of the Silver-current source table (without current__ prefix)"
                    },
                    "columns": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "description": "Mapping from harmonized column name to intermediate column name"
                      }
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "enabled": { "const": true }
                  }
                },
                "then": {
                  "required": ["profile", "tables"]
                }
              }
            ]
          },
          "quality": {
            "type": "object",
            "required": ["enabled"],
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "profile": {
                "type": "string",
                "description": "Code-driven quality profile identifier"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "enabled": { "const": true }
                  }
                },
                "then": {
                  "required": ["profile"]
                }
              }
            ]
          }
        }
      }
    }
  }
}
