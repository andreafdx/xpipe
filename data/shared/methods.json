{
  "quani_mdb": {
    "schema_domain": "sdo",
    "type": "access_mdb",
    "input_type": "file",
    "input_map": {"quanivb" : "*.mdb"},
    "components": {
      "TblScheda" : "quanivb",
      "TblSchedaDiagnosi": "quanivb",
      "TblSchedaProcedure": "quanivb",
      "TblSchedaTrasferimenti": "quanivb"
    },
    "anchor_table": "TblScheda",
    "identity_keys": ["i_IDScheda"],
    "partition_column": "d_DataDimissione",
    "pseudonymize": ["c_CodicePaziente", "c_CodiceMadre"],
    "skip": ["v_Nome", "v_Cognome"]
  },

  "xml_campania_2026": {
    "schema_domain": "sdo",
    "type": "xml",
    "input_type": "directory",
    "input_map": {
      "tracciato_a": "*_A.xml",
      "tracciato_b": "*_B.xml"
    },
    "components": {
      "anagrafica": "tracciato_a",
      "ricovero": "tracciato_b",
      "diagnosi": "tracciato_b",
      "procedure": "tracciato_b",
      "trasferimenti": "tracciato_b",
      "accessi_dh": "tracciato_b"
    },
    "anchor_table": "ricovero",
    "identity_keys": ["codiceIstitutoDiCura", "progressivoSDO"],
    "partition_column": "dim_dataDimissioneMorte",
    "pseudonymize": ["identificativoPaziente", "codiceFiscale"],
    "skip": ["cognome", "nome"]
  },

  "ps_csv": {
    "schema_domain": "ps",
    "type": "csv",
    "input_type": "file",
    "anchor_table": "data",
    "identity_keys": ["id_accesso"],
    "partition_column": "data_ingresso",
    "pseudonymize": ["cf"],
    "skip": ["nome", "cognome"]
  }
}
