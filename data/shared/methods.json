{
  "quani_mdb": {
    "schema_domain": "sdo",
    "type": "access_mdb",
    "input_type": "file",
    "source_tables": [
      "TblScheda",
      "TblSchedaDiagnosi",
      "TblSchedaProcedure",
      "TblSchedaTrasferimenti"
    ],
    "anchor_table": "TblScheda",
    "identity_keys": ["i_IDScheda"],
    "partition_column": "d_DataDimissione",
    "pseudonymize": ["c_CodicePaziente", "c_CodiceMadre"],
    "skip": ["v_Nome", "v_Cognome"]
  },

  "xml_campania_2026": {
    "schema_domain": "sdo",
    "type": "xml",
    "input_type": "directory",
    "xml_profile": "sdo_tracciato_abcd",

    "input_files": {
      "file_a": "*_A.xml",
      "file_b": "*_B.xml"
    },

    "output_tables": {
      "required": ["ricovero"],
      "optional": ["diagnosi", "procedure", "trasferimenti", "accessi_dh"]
    },


    "anchor_table": "ricovero",
    "identity_keys": ["codiceIstitutoDiCura", "progressivoSDO"],
    "partition_column": "dim_dataDimissioneMorte",
    "privacy": {
      "hash": {
        "ricovero": {
          "identificativoPaziente": "scalar",
          "codiceFiscale": "scalar"
        },
        "procedure": {
          "chirurgoIntervento": "list",
          "anestesistaIntervento": "list"
        }
      },
      "skip": {
        "ricovero": {
          "nome": "scalar",
          "cognome": "scalar"
        }
      }
    },
    "column_types": {
      "ricovero": {
        "codiceIstitutoDiCura": "character",
        "progressivoSDO": "character",
        "unitaOperativaAmmissione": "character",
        "dim_unitaOperativaDimissione": "character",
        "DRG": "character"
      },
      "diagnosi": {
        "codiceIstitutoDiCura": "character",
        "progressivoSDO": "character",
        "diagnosiDimissione": "character"
      },
      "procedure": {
        "codiceIstitutoDiCura": "character",
        "progressivoSDO": "character",
        "intervento": "character"
      }
}
  },

  "ps_csv": {
    "schema_domain": "ps",
    "type": "csv",
    "input_type": "file",
    "anchor_table": "data",
    "identity_keys": ["id_accesso"],
    "partition_column": "data_ingresso",
    "pseudonymize": ["cf"],
    "skip": ["nome", "cognome"]
  }
}
